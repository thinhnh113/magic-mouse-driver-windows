<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <!-- Single-project builds default to AnyCPU, which would output to bin\Release instead of bin\x64\Release
         like the solution build. Pin x64 so every build lands in the same folder. -->
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.3</Version>
    <Product>MagicMouse</Product>
  </PropertyGroup>
</Project>
